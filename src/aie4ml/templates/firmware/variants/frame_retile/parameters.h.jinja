{% from 'variants/placement.jinja' import buffer_locations %}
{% set P = L.op_impl.parameters %}
// A retiler: its source -- the tensor as the boundary carries it, or the frame a producer wrote -- and
// the column-grouped frame it builds for the strided conv that reads it. One kernel per window builds
// that window's tile of the frame (a row band, a channel slice, or both), configured by a struct of its
// own that completes these fields with what that window reads; `window<w>::type` names it for the
// graph. (A kernel's configuration must be a plain struct: the AIE compiler cannot wrap a kernel
// templated on a member template.)
struct {{L.struct_name}} {
  using data_t = {{P.precision.c_type}};
  static constexpr int CAS_NUM = {{P.parallelism.cas_num}}, CAS_LENGTH = {{P.parallelism.cas_length}};
  static constexpr int SRC_W = {{P.src_w}};
  static constexpr int ROWS = {{P.rows}}, COLS = {{P.cols}}, CB = {{P.blocks}};
  static constexpr bool FOLD = false;
  static constexpr int STRIDE = {{P.stride}};
  static constexpr int ORIGIN_C = {{P.origin_c}};
  static constexpr int FRAME_BYTES = {{P.frame_bytes}};
  static constexpr int col_placement = {{L.placement.col}};
  static constexpr int row_placement = {{L.placement.row}};
{{ buffer_locations('IN1_BUFFER_LOCATIONS', P.buffer_locations | selectattr('port_group', 'equalto', 'in1') | list) }}
{{ buffer_locations('OUT1_BUFFER_LOCATIONS', P.buffer_locations | selectattr('port_group', 'equalto', 'out1') | list) }}
  template<int WINDOW> struct window;
};
{% for w in P.windows %}
struct {{L.struct_name}}_window{{loop.index0}} : {{L.struct_name}} {
  static constexpr int SRC_H = {{w.rows}}, SRC_C = {{w['channels']}};
  static constexpr int SRC_BYTES = {{w.transfer_bytes}};
  static constexpr int SRC_BASE = {{w.base}}, SRC_PIXEL = {{w.pixel}};
  static constexpr int SRC_ROW = {{w.row}}, SRC_BLOCK = {{w.block}};
  static constexpr int ORIGIN_R = {{w.origin_row}};
};
template<> struct {{L.struct_name}}::window<{{loop.index0}}> { using type = {{L.struct_name}}_window{{loop.index0}}; };
{% endfor %}
