{% set P = L.op_impl.parameters %}
{% from 'variants/placement.jinja' import buffer_locations %}
struct {{L.struct_name}} {
  using lhs_t = {{P.precision.lhs.c_type}};
  using rhs_t = {{P.precision.rhs.c_type}};
  using result_t = {{P.precision.output.c_type}};
  using acc_scalar_t = {{ P.accumulator_tag }};
  static constexpr int CAS_NUM = {{P.parallelism.cas_num}};
  static constexpr int CAS_LENGTH = {{P.parallelism.cas_length}};
  static constexpr int VEC_SIZE = {{P.vec_size}};
  static constexpr int TILE_ELEMENTS = {{P.tile_elements}};
{{ buffer_locations('IN1_BUFFER_LOCATIONS', P.buffer_locations | selectattr('port_group', 'equalto', 'in1') | list) }}
{{ buffer_locations('IN2_BUFFER_LOCATIONS', P.buffer_locations | selectattr('port_group', 'equalto', 'in2') | list) }}
{{ buffer_locations('OUT1_BUFFER_LOCATIONS', P.buffer_locations | selectattr('port_group', 'equalto', 'out1') | list) }}
  static constexpr bool TRANSPOSE_LHS = {{ 'true' if P.flags.transpose_lhs else 'false' }};
  static constexpr bool TRANSPOSE_RHS = {{ 'true' if P.flags.transpose_rhs else 'false' }};
  static constexpr bool USE_RELU = {{ 'true' if P.flags.use_relu else 'false' }};
  static constexpr int  MICROTILE_OUTER = {{ P.microtile.outer if P.microtile else 0 }};
  static constexpr int  MICROTILE_INNER = {{ P.microtile.inner if P.microtile else 0 }};
  static constexpr int SHIFT = {{P.shift}};
  static constexpr const char* ROUNDING_TOKEN = "{{ P.rounding_mode }}";
  static constexpr const char* SATURATION_TOKEN = "saturate";
#if __cplusplus >= 202002L
  static constexpr auto ROUNDING   = aie::rounding_mode::{{ P.rounding_mode }};
  static constexpr auto SATURATION = aie::saturation_mode::saturate;
#endif
  static constexpr int col_placement = {{L.placement.col}};
  static constexpr int row_placement = {{L.placement.row}};
};
