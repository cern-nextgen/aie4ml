#include "parameters.h"
#include "top_graph.h"
#if defined(__AIESIM__)
#include <cstdio>
#endif

using namespace adf;

extern "C" {
{% for L in layers %}
  {% for spec in L.artifacts %}
  #include "weights/{{ spec.filename }}"
  {% endfor %}
{% endfor %}
}

template<typename... Ts> struct type_list {};

class dut_graph : public graph {
public:
  input_plio plio_data[{{ graph_plan.graph_input_count }}];

{% for L in layers %}
  {% set Lidx = loop.index %}
  {% for spec in L.artifacts %}
    {% if spec.kind == "2d" %}
  input_port {{ spec.port }}{{ Lidx }}[{{ L.struct_name }}::CAS_NUM * {{ L.struct_name }}::CAS_LENGTH];
    {% elif spec.kind == "1d" %}
  input_port {{ spec.port }}{{ Lidx }}[{{ L.struct_name }}::CAS_NUM];
    {% endif %}
  {% endfor %}
{% endfor %}

  output_plio plio_ofm[{{ graph_plan.graph_output_count }}];

  top_graph<
  {%- for i in range(1, layers|length + 1) -%}
    L{{ i }}Cfg{{ ", " if not loop.last else "" }}
  {%- endfor -%}
  > dut;

  dut_graph() {
    for (int col = 0; col < {{ graph_plan.graph_input_count }}; ++col) {
      plio_data[col] = input_plio::create(
        "PLIO_ifm_" + std::to_string(col),
        plio_{{ plio_bitwidth }}_bits,
        "data/ifm_c" + std::to_string(col) + ".txt"
      );
      connect<>(plio_data[col].out[0], dut.ifm[col]);
    }

{% for L in layers %}
    {% set Lidx = loop.index %}
    for (int chain = 0; chain < {{ L.struct_name }}::CAS_NUM; ++chain) {
      for (int col = 0; col < {{ L.struct_name }}::CAS_LENGTH; ++col) {
        int idx = chain * {{ L.struct_name }}::CAS_LENGTH + col;
        {% for spec in L.artifacts %}
        {% if spec.kind == "2d" %}
        connect<>( {{ spec.port }}{{ Lidx }}[idx], dut.{{ spec.port }}{{ Lidx }}[idx]);
        {% endif %}
        {% endfor %}
      }

      {% for spec in L.artifacts %}
      {% if spec.kind == "1d" %}
      connect<>( {{ spec.port }}{{ Lidx }}[chain], dut.{{ spec.port }}{{ Lidx }}[chain]);
      {% endif %}
      {% endfor %}
    }
{% endfor %}

    for (int ch = 0; ch < {{ graph_plan.graph_output_count }}; ++ch) {
      plio_ofm[ch] = output_plio::create(
        "PLIO_ofm_" + std::to_string(ch),
        plio_{{ plio_bitwidth }}_bits,
        "data/y_p" + std::to_string(ch) + ".txt"
      );
      connect<>(dut.ofm[ch], plio_ofm[ch].in[0]);
    }
  }
};

dut_graph dut;

#if defined(__AIESIM__) || defined(__X86SIM__)
// Graph iterations the simulator runs.
#define N_ITER {{ iterations }}

int main() {
  dut.init();

{% for L in layers %}
  {% set Lidx = loop.index %}
  {% for spec in L.artifacts %}

  {% if spec.kind == "2d" %}
  for (int ch = 0; ch < {{ L.struct_name }}::CAS_NUM; ++ch) {
    for (int col = 0; col < {{ L.struct_name }}::CAS_LENGTH; ++col) {
      int idx = ch * {{ L.struct_name }}::CAS_LENGTH + col;
      dut.update(
        dut.{{ spec.port }}{{ Lidx }}[idx],
        {% if spec.storage_dtype and spec.storage_dtype != spec.dtype %}
        reinterpret_cast<{{ spec.dtype }} const*>({{ spec.name }}_{{ L.inst_name }}[ch][col]),
        {% else %}
        {{ spec.name }}_{{ L.inst_name }}[ch][col],
        {% endif %}
        {{ spec.array[0][0]|length }}
      );
    }
  }
  {% endif %}

  {% if spec.kind == "1d" %}
  for (int ch = 0; ch < {{ L.struct_name }}::CAS_NUM; ++ch) {
    dut.update(
      dut.{{ spec.port }}{{ Lidx }}[ch],
      {% if spec.storage_dtype and spec.storage_dtype != spec.dtype %}
      reinterpret_cast<{{ spec.dtype }} const*>({{ spec.name }}_{{ L.inst_name }}[ch]),
      {% else %}
      {{ spec.name }}_{{ L.inst_name }}[ch],
      {% endif %}
      {{ spec.array[0]|length }}
    );
  }
  {% endif %}

  {% endfor %}
{% endfor %}

#if defined(__AIESIM__)
  // First input to first output beat, in AIE cycles. Input flows only after run(), even with async RTP weights,
  // so array configuration and weight writes never count. Every input starts at run(), so any input's first beat
  // marks the start: the first input whose shim tile can broadcast its event to the output's is taken (a free
  // broadcast channel must span the shim tiles between them). Where none can, nothing is printed.
  event::handle latency = event::invalid_handle;
  for (int i = 0; i < {{ graph_plan.graph_input_count }} && latency == event::invalid_handle; ++i) {
    latency = event::start_profiling(dut.plio_data[i], dut.plio_ofm[0], event::io_stream_start_difference_cycles);
  }
  dut.run(N_ITER);
  dut.wait();
  if (latency != event::invalid_handle) {
    std::printf("AIE4ML_LATENCY_START_CC %lld\n", static_cast<long long>(event::read_profiling(latency)));
    event::stop_profiling(latency);
  }
#else
  dut.run(N_ITER);
#endif
  dut.end();
  return 0;
}
#endif
